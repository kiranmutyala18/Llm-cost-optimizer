# --- Database ---
DATABASE_URL=postgresql+psycopg2://llmopt:llmopt@localhost:5432/llm_optimizer

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Semantic cache ---
# "local" = free deterministic hashing embedder, no external calls (good for dev/tests)
# "openai" = real OpenAI embeddings for production-quality semantic matching
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=256
SIMILARITY_THRESHOLD=0.92
EXACT_CACHE_TTL_SECONDS=86400

# --- Upstream LLM being proxied ---
# "mock" = deterministic fake responses, no external calls (good for dev/tests)
# "openai" = forwards to OpenAI's real chat completions API
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Rate limiting ---
DEFAULT_RATE_LIMIT_PER_MINUTE=60
